{
  "name": "@alisaitteke/ttt",
  "version": "0.2.17",
  "description": "TTT (The Tortoise Trainer) — provider-driven local MCP orchestrator with optional bundled web UI for Adobe automation, Docker, and more backends (scaffolded integrations: Figma, OpenClaw, Hermes)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ttt": "dist/index.js"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsc-watch --onSuccess \"tsc-alias\"",
    "dev:ui": "concurrently -n server,web -c blue,green \"npm:dev:ui:server\" \"npm:dev:ui:web\"",
    "dev:ui:server": "tsx watch src/ui/cli.ts --port 5174 --no-open",
    "dev:ui:web": "npm --prefix web run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc && tsc-alias && chmod +x dist/index.js dist/ui/cli.js",
    "build:server:bundle": "node scripts/build-server-bundle.mjs",
    "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "start": "node dist/index.js",
    "start:ui": "node dist/ui/cli.js",
    "lint": "eslint src --ext .ts",
    "verify:docker-tools": "tsx scripts/verify-docker-tool-parity.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "tauri": "tauri",
    "tauri:dev": "cross-env TAURI=1 tauri dev",
    "tauri:build": "tauri build",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-automation",
    "local-automation",
    "orchestrator",
    "ai",
    "photoshop",
    "docker",
    "figma",
    "after-effects",
    "creative-cloud",
    "ttt"
  ],
  "author": "Ali Sait Teke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisaitteke/ttt.git"
  },
  "homepage": "https://github.com/alisaitteke/ttt#readme",
  "bugs": {
    "url": "https://github.com/alisaitteke/ttt/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/groq": "^3.0.38",
    "@ai-sdk/mcp": "^1.0.40",
    "@ai-sdk/openai": "^3.0.61",
    "@alisaitteke/docker-mcp": "^0.2.4",
    "@hapi/boom": "^9.1.3",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@whiskeysockets/baileys": "^6.7.21",
    "ai": "^6.0.175",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.9.0",
    "get-port": "^7.1.0",
    "hono": "^4.6.14",
    "open": "^10.1.0",
    "pino": "^9.6.0"
  },
  "overrides": {
    "uuid": "^11.0.0"
  },
  "mcpName": "io.github.alisaitteke/ttt",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.18.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "tsc-watch": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
