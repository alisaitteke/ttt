<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 inside the bundled Node sidecar needs to mark JIT pages as executable. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Native modules (better-sqlite3, sharp/libvips, keytar, ssh2/cpu-features)
       dlopen their own bundled dylibs at runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Lets the sidecar honor NODE_OPTIONS / TTT_* env vars set by the shell. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
